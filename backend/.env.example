OPENROUTER_API_KEY=your_openrouter_api_key_here
PORT=5000
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Optional: override the primary model used for X-ray analysis only
# OPENROUTER_XRAY_MODEL=google/gemma-4-31b-it:free
# Comma-separated list of allowed origins (leave empty in dev to allow all)
# Production example: ALLOWED_ORIGINS=https://reportanalysis-frontend.onrender.com
ALLOWED_ORIGINS=
